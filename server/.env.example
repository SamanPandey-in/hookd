# ─────────────────────────────────────────────────────────────────────────────
# hookd backend — environment template
# Copy to `.env` (local) or set these as real environment variables (EC2).
# NEVER commit the filled-in .env — it holds live secrets. Only this .example
# file is tracked. Generate keys with the commands noted inline.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the Go server listens on (behind the reverse proxy in prod).
PORT=8099

# Interface to bind. Empty = all interfaces. Behind Caddy on the same host, set
# 127.0.0.1 so the API is unreachable except through the proxy — this also makes
# X-Forwarded-For unspoofable (only the proxy can set it). The compose path keeps
# the API on an internal network instead, so leave this empty there.
BIND_ADDR=127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled endpoint recommended). Must include
# sslmode=require. When set, the server runs migrations on boot and uses
# Postgres; when empty it falls back to an in-memory dev store (NOT for prod).
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ── Crypto / sessions (REQUIRED in prod) ────────────────────────────────────
# AES-256 key that encrypts signing secrets at rest — base64 of exactly 32 bytes.
#   generate:  openssl rand -base64 32
SECRET_ENC_KEY=

# HMAC key that signs session cookies — any high-entropy string, >= 16 bytes.
#   generate:  openssl rand -base64 48
SESSION_KEY=

# ── CORS + cookies (cross-site: Vercel frontend ↔ EC2 API) ──────────────────
# The EXACT frontend origin allowed to call this API with credentials.
ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Serve behind TLS in prod → cookies must be Secure.
COOKIE_SECURE=true

# SameSite for the session cookie. Frontend and API on DIFFERENT registrable
# domains (e.g. *.vercel.app + an EC2 domain) are "cross-site" → use `none`
# (requires COOKIE_SECURE=true) or the browser drops the cookie and the app
# looks logged-out. If instead you put both on ONE parent domain (app.hookd.dev
# + api.hookd.dev), use `lax` and set COOKIE_DOMAIN=.hookd.dev below.
COOKIE_SAMESITE=none

# Optional: parent domain to share the auth cookie across subdomains. Leave
# empty for the Vercel+EC2 split; set e.g. .hookd.dev for the subdomain setup.
COOKIE_DOMAIN=

# ── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers with the
# Authorization callback URL set to GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.your-domain.com/auth/github/callback

# ── Dodo Payments (billing — optional; empty = everyone stays free) ─────────
# When DODO_API_KEY is unset, /api/billing/* and /webhooks/dodo return 503 and
# the app works fully on the free plan. Fill these to enable Pro checkout.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_ANNUAL=
DODO_SUCCESS_URL=https://your-frontend.vercel.app/app?billing=success
DODO_CANCEL_URL=https://your-frontend.vercel.app/app?billing=cancelled

# ── Caps / tuning (optional; sane defaults shown) ───────────────────────────
# MAX_BODY_BYTES=1048576
# INGEST_RATE_PER_MIN=120
# INGEST_BURST=40
# IP_RATE_PER_MIN=300
# IP_BURST=100
# REPLAY_TIMEOUT_SECONDS=10
# MAX_REPLAY_RESP_BODY=262144

# Retention purger: how often expired events are deleted (minutes). Each
# endpoint's retention_days is capped by its owner's plan. 0 disables purging.
# PURGE_INTERVAL_MINUTES=60

# ── Constrained networks only (local sandbox) ───────────────────────────────
# Force a DNS resolver when the host resolver can't reach Neon. NOT needed on a
# normal machine or EC2 — leave unset.
# DNS_RESOLVER=8.8.8.8:53
