# Normalize line endings to LF across the repo so the codebase works the same
# on macOS, Linux and Windows. Text files are stored and checked out with LF.
* text=auto eol=lf

# Explicit text types (LF)
*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.env     text eol=lf
.gitignore text eol=lf

# Binary files — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.exe  binary
*.gz   binary
*.zip  binary
